# Worker image for the Contractor node — same build as ./Dockerfile, but the entrypoint runs the BullMQ
# worker (notifications dispatch + the Phase-2 billing-cycle) instead of the api. Selected on Railway via the
# worker service's RAILWAY_DOCKERFILE_PATH=Dockerfile.worker. Keep the build steps in sync with ./Dockerfile.
FROM node:22-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @contractor/db generate

ENV NODE_ENV=production
CMD ["pnpm", "--filter", "@contractor/worker", "start:prod"]
