# Contractor node — env. Copy to .env and fill. Local dev: `pnpm infra:up` gives Postgres+Redis on the
# ports below; provider clients (Clerk/Resend/R2/Stripe/Supabase) no-op or stub when their keys are unset.

# Database (local docker compose maps 5436 -> postgres). Prod: Supabase pooled (DATABASE_URL) + direct (DIRECT_URL).
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/contractor?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5436/contractor?schema=public"

# Redis (local docker compose maps 6383 -> redis). Prod: a rediss:// TCP URL (e.g. Upstash) for BullMQ.
REDIS_URL="redis://localhost:6383"

# Clerk (same instance as the rest of the portfolio; approval sets publicMetadata.role='contractor')
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""

# Supabase (Realtime fan-out for DMs/bids; service key for server-side).
# ALSO powers profile image uploads (avatar + image blocks) → public 'media' bucket. The upload runs in a
# WEB server action, so SUPABASE_URL + SUPABASE_SERVICE_KEY must be set on the WEB deploy too, not just the api.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_MEDIA_BUCKET="media"

# Service key the api requires on inbound Board provider calls (board -> contractor /provider/*)
CONTRACTOR_SERVICE_KEY=""

# Board provider seam (contractor -> board, Phase 2; opaque cross-app refs)
BOARD_API_URL=""
BOARD_SERVICE_KEY=""

# Cloudflare R2 (post media + avatars)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="reely-contractor"
R2_PUBLIC_BASE_URL=""

# Resend (vetting + notification email)
RESEND_API_KEY=""

# Stripe Connect Express (Phase 2 — payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Multi-zone asset prefix (set on Vercel to the contractor web origin so /_next assets resolve)
ASSET_PREFIX=""

# Observability
SENTRY_DSN=""
POSTHOG_KEY=""

# Beta feedback widget → Catalog sink (set on the WEB deploy too). CATALOG_SERVICE_KEY = the portfolio service key.
CATALOG_API_URL=""
CATALOG_SERVICE_KEY=""
