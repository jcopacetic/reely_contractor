// Contractor data model — generated from reely/06-Contractor/contractor.manifest.json (dataModel).
// AUTHORITATIVE: the manifest. When code and manifest disagree, the manifest wins.
//
// Model posture (manifest dataModel.multiTenancy):
//  - USER-SCOPED, NO TENANT. isolationStrategy = user_and_participant_rls, clerkOrgMapping = false.
//    Clerk authenticates the User only; `contractor_identity` is a verified layer on the base User.
//    `*_user_id` columns hold the Clerk User id (the User is never a local table). Clients appear only as
//    opaque Clerk User ids on two-party entities (contract/listing/bid/thread) — never a Contractor row.
//  - RLS keys on Postgres GUCs set per request by `withUser` (src/index.ts): `app.actor_user` (the Clerk
//    user id), `app.actor` (role: contractor | applicant | platform_admin | system). Policy BODIES live in
//    prisma/rls.sql (applied by apply-rls.ts); this schema defines tables/columns/enums/indexes only.
//  - `board_part_ref` / `board_ref` / `listing_ref` are EXTERNAL Board entity ids — cross-app references,
//    NEVER FKs/JOINs.
//
// SCOPE: this file carries the FOUNDATION tables (identity/application/invite/profile/skill_category +
// app_event/feature_flag) and the SOCIAL tables (post/media/follow/reaction/comment/achievement/stats/dm),
// authored social-club-first by lifting Stumble's proven social models (a recorded deviation from the
// manifest's work-first v1). The WORK-LOOP tables (listing/bid/contract/time/billing/charge/payout/dispute)
// land in Phase 2 directly from the manifest.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, pgTrgm(map: "pg_trgm")]
}

// ── Enums ─────────────────────────────────────────────────────────────────────
enum ContractorStatus {
  applicant
  vetted
  suspended
}

enum ApplicationSource {
  apply
  invite
}

enum ApplicationStatus {
  submitted
  in_review
  approved
  rejected
}

enum InviteStatus {
  sent
  accepted
  expired
}

enum ActorType {
  contractor
  applicant
  admin
  client
  system
  controller
}

// Social
enum PostKind {
  update
  milestone
  achievement
}

enum PostVisibility {
  public
  followers
}

enum MediaType {
  image
  video_embed
}

enum ReactionType {
  like
  celebrate
  insightful
  fire
  support
}

// Work-loop
enum BudgetType {
  hourly
  fixed
}

enum ListingStatus {
  open
  closed
  filled
}

enum BidStatus {
  submitted
  countered
  denied
  accepted
  withdrawn
}

enum ContractStatus {
  active
  paused
  completed
  cancelled
}

enum ContractItemKind {
  milestone
  scope_add
  deliverable
  note
}

enum ContractItemStatus {
  open
  done
  void
}

enum TimeSource {
  timer
  extension
  manual
}

// ── Foundation ─────────────────────────────────────────────────────────────────
/// The principal — a verified layer on the base Clerk User. The vetting gate.
model ContractorIdentity {
  id            String           @id @default(uuid()) @db.Uuid
  clerkUserId   String           @unique @map("clerk_user_id")
  status        ContractorStatus @default(applicant)
  vettedAt      DateTime?        @map("vetted_at")
  suspendReason String?          @map("suspend_reason") // why the admin disabled them (governance kill-switch)
  suspendedAt   DateTime?        @map("suspended_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  profile ContractorProfile?

  @@index([status])
  @@map("contractor_identity")
}

/// Vetting lifecycle. Applicant reads own; admin reads/writes all.
model Application {
  id          String            @id @default(uuid()) @db.Uuid
  clerkUserId String            @map("clerk_user_id")
  source      ApplicationSource
  status      ApplicationStatus @default(submitted)
  videoLink   String?           @map("video_link") // out-of-system call link (manual v1)
  reviewerId  String?           @map("reviewer_id") // admin Clerk id
  notes       String? // internal
  decidedAt   DateTime?         @map("decided_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([clerkUserId])
  @@index([status])
  @@map("application")
}

/// Admin-managed invite system. Redemption updates status by code.
model Invite {
  id         String       @id @default(uuid()) @db.Uuid
  email      String
  code       String       @unique // redemption token
  invitedBy  String       @map("invited_by") // admin Clerk id
  status     InviteStatus @default(sent)
  acceptedAt DateTime?    @map("accepted_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([email])
  @@map("invite")
}

/// Public marketing + professional profile (linktree-style). Public read of the safe subset when is_public.
model ContractorProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  contractorIdentityId String  @unique @map("contractor_identity_id") @db.Uuid
  identity            ContractorIdentity @relation(fields: [contractorIdentityId], references: [id], onDelete: Cascade)
  clerkUserId         String   @unique @map("clerk_user_id") // denormalized for user-scoped RLS + author joins
  firstName           String   @default("") @map("first_name") // the PERSON's identity (public). A profile is an individual, not a company.
  lastName            String   @default("") @map("last_name") // (public)
  displayName         String   @map("display_name") // public — DERIVED from first + last on save; what surfaces render
  company             String?  @map("company") // optional ATTRIBUTE — where they work; never the account identity (public)
  position            String?  @map("position") // optional attribute — their role/title (public)
  headline            String? // public
  bio                 String?  @db.Text // public
  categoryIds         Json     @default("[]") @map("category_ids") // skill_category ids; GIN; filter source; public labels
  isPublic            Boolean  @default(false) @map("is_public") // gates the public surface
  publicSlug          String?  @unique @map("public_slug") // shareable URL
  avatarUrl           String?  @map("avatar_url") // R2; public
  links               Json     @default("[]") // [{label,url}]; public — LEGACY (superseded by a links block; kept for back-compat)
  blocks              Json     @default("[]") // ordered landing-page content blocks (text/links/image/list); public
  contractsCompleted  Int      @default(0) @map("contracts_completed") // system-driven rollup; public
  hoursLogged         Decimal  @default(0) @map("hours_logged") @db.Decimal(12, 2) // system-driven rollup; public
  onboardedAt         DateTime? @map("onboarded_at") // set when onboarding (categories + docs) completes
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("contractor_profile")
}

/// Curated skill vocabulary (admin-managed; NOT derived from Catalog taxonomy). The job↔contractor match key.
model SkillCategory {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  slug   String  @unique
  active Boolean @default(true)
  order  Int     @default(0)

  @@map("skill_category")
}

/// Simple signed-doc acknowledgement captured during onboarding (e-sign integration deferred).
model OnboardingDoc {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @map("clerk_user_id")
  docKey      String   @map("doc_key") // e.g. "contractor-agreement", "w9"
  version     String   @default("v1")
  acceptedAt  DateTime @default(now()) @map("accepted_at")

  @@unique([clerkUserId, docKey])
  @@map("onboarding_doc")
}

// ── Social club (authored; lifted from Stumble's community/social-graph/gamification) ──────────────────
/// A contractor post: text + optional media (image upload / video embed). Visible to followers (or public).
model Post {
  id            String         @id @default(uuid()) @db.Uuid
  authorUserId  String         @map("author_user_id") // vetted contractor Clerk id
  body          String         @db.Text
  kind          PostKind       @default(update)
  visibility    PostVisibility @default(followers)
  // Provenance for system milestone/achievement auto-shares (opaque; never an FK).
  sourceRef     String?        @map("source_ref")
  linkUrl       String?        @map("link_url") // work-activity posts link to their artifact (a job/contract)
  linkLabel     String?        @map("link_label") // e.g. "View job"
  reactionCount Int            @default(0) @map("reaction_count") // maintained aggregate
  commentCount  Int            @default(0) @map("comment_count")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  media     PostMedia[]
  comments  Comment[]
  reactions Reaction[]

  @@index([authorUserId])
  @@index([createdAt])
  @@map("post")
}

model PostMedia {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String // R2 object url (image) or embed src (video)
  embedHtml String?   @map("embed_html") // sanitized provider embed (video)
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([postId])
  @@map("post_media")
}

/// Follow edge (user pair; no self-follow). Drives follower-scoped feed visibility.
model Follow {
  id             String   @id @default(uuid()) @db.Uuid
  followerUserId String   @map("follower_user_id")
  followeeUserId String   @map("followee_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([followerUserId, followeeUserId])
  @@index([followeeUserId])
  @@map("follow")
}

/// One reaction per (user, post); changing type upserts, reacting same type clears (handled in app).
model Reaction {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id")
  postId    String       @map("post_id") @db.Uuid
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([userId, postId])
  @@index([postId])
  @@map("reaction")
}

/// Threaded comment on a post (parent_id self-ref for replies).
model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  parentId  String?   @map("parent_id") @db.Uuid
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  body      String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([postId])
  @@index([parentId])
  @@map("comment")
}

/// Achievement definitions (onboarding + use-run). Awarded from events.
model Achievement {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String?
  criteria    Json    @default("{}")
  xp          Int     @default(0)
  order       Int     @default(0)

  awards AchievementAward[]

  @@map("achievement")
}

/// Append-only award (idempotent per user+achievement).
model AchievementAward {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id")
  achievementId String      @map("achievement_id") @db.Uuid
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  awardedAt     DateTime    @default(now()) @map("awarded_at")

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("achievement_award")
}

/// Per-contractor gamification state (xp/level/streak), maintained by the achievements module.
model ContractorStats {
  clerkUserId   String   @id @map("clerk_user_id")
  xp            Int      @default(0)
  level         Int      @default(1)
  streak        Int      @default(0)
  lastActiveDay String?  @map("last_active_day") // YYYY-MM-DD
  postCount     Int      @default(0) @map("post_count")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("contractor_stats")
}

/// Chat rooms (generalizes the old 1:1 DM). A `direct` room is contractor↔contractor (the social club);
/// `hire`/`team` rooms pair a tenant (an opaque Board org ref) with one or more contractors. Every message is
/// sent by an individual; a tenant-side message carries `sender_tenant_ref` for "Name · Org" attribution.
enum RoomKind {
  direct
  hire
  team
}

enum RoomParticipantKind {
  contractor
  tenant
}

model Room {
  id            String    @id @default(uuid()) @db.Uuid
  kind          RoomKind
  tenantRef     String?   @map("tenant_ref") // opaque Board org ref (hire/team); REFERENCE, never an FK
  boardRef      String?   @map("board_ref") // opaque work anchor (a contract/part); REFERENCE, never an FK
  title         String? // org/team display label (set by Board for hire/team rooms)
  createdBy     String    @map("created_by")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  participants RoomParticipant[]
  messages     RoomMessage[]
  reads        RoomRead[]

  @@index([tenantRef])
  @@map("room")
}

model RoomParticipant {
  id               String              @id @default(uuid()) @db.Uuid
  roomId           String              @map("room_id") @db.Uuid
  room             Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  kind             RoomParticipantKind
  contractorUserId String?             @map("contractor_user_id") // set when kind=contractor
  tenantRef        String?             @map("tenant_ref") // set when kind=tenant (the org)
  joinedAt         DateTime            @default(now()) @map("joined_at") // history floor (team join-gating)
  leftAt           DateTime?           @map("left_at")

  @@unique([roomId, contractorUserId])
  @@index([contractorUserId])
  @@index([roomId])
  @@map("room_participant")
}

model RoomMessage {
  id              String   @id @default(uuid()) @db.Uuid
  roomId          String   @map("room_id") @db.Uuid
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderUserId    String   @map("sender_user_id") // the individual (a contractor or a tenant member)
  senderTenantRef String?  @map("sender_tenant_ref") // set when sent by a tenant member → "Name · Org"
  senderLabel     String?  @map("sender_label") // display name for tenant-member senders (Board provides it; contractor senders resolve via profile)
  body            String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@map("room_message")
}

model RoomRead {
  id         String   @id @default(uuid()) @db.Uuid
  roomId     String   @map("room_id") @db.Uuid
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  lastReadAt DateTime @map("last_read_at")

  @@unique([roomId, userId])
  @@map("room_read")
}

/// User-scoped notification (bell + email). Sole writer = the notifications module / emit() fan-out.
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") // recipient Clerk id
  type        String
  payload     Json      @default("{}")
  readAt      DateTime? @map("read_at")
  emailedAt   DateTime? @map("emailed_at") // set when included in an email digest (each notification emailed once)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("notification")
}

/// Per-recipient notification preferences (keyed by Clerk user id; works for contractors AND Board clients,
/// neither of which necessarily has another profile row). v1 = a single email-digest opt-out, flipped by the
/// one-click unsubscribe link (HMAC-token verified). Absent row = subscribed (the default).
model NotificationPref {
  userId            String   @id @map("user_id")
  emailUnsubscribed Boolean  @default(false) @map("email_unsubscribed")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("notification_pref")
}

// ── Work-loop: marketplace (listing + bid) ──────────────────────────────────────
/// A job listing — posted natively by a vetted contractor (subcontracting) or by Board on behalf of a
/// client via the provider surface (carrying an opaque board_part_ref). The data authority behind the
/// job-feed. Read by any vetted contractor (browse) + the owner; written by the owner or Board (provider).
model Listing {
  id           String        @id @default(uuid()) @db.Uuid
  ownerUserId  String        @map("owner_user_id") // client Clerk id (Board member or native owner)
  boardPartRef String?       @map("board_part_ref") // opaque Board part id when Board-originated; REFERENCE, never FK
  title        String
  description  String        @db.Text // the brief
  categoryIds  String[]      @map("category_ids") // skill_category ids; text[] + GIN; the job↔contractor match key
  budgetType   BudgetType    @map("budget_type")
  budgetAmount Decimal?      @map("budget_amount") @db.Decimal(12, 2)
  status       ListingStatus @default(open)
  createdAt    DateTime      @default(now()) @map("created_at")
  closedAt     DateTime?     @map("closed_at")
  deletedAt    DateTime?     @map("deleted_at") // soft-delete

  bids      Bid[]
  contracts Contract[]

  @@index([ownerUserId])
  @@index([boardPartRef])
  @@index([status])
  @@index([categoryIds], type: Gin)
  @@map("listing")
}

/// A bid on a listing by a vetted contractor. Participant-scoped (bidder + listing owner). counterOf
/// self-references the bid a counter responds to. Status transitions only (no hard delete).
model Bid {
  id            String     @id @default(uuid()) @db.Uuid
  listingId     String     @map("listing_id") @db.Uuid
  listing       Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderUserId  String     @map("bidder_user_id") // contractor Clerk id; must be vetted at insert
  rateType      BudgetType @map("rate_type")
  amount        Decimal    @db.Decimal(12, 2)
  hoursEstimate Decimal?   @map("hours_estimate") @db.Decimal(10, 2)
  message       String?    @db.Text
  status        BidStatus  @default(submitted)
  counterOfId   String?    @map("counter_of_id") @db.Uuid
  counterOf     Bid?       @relation("BidCounter", fields: [counterOfId], references: [id])
  counters      Bid[]      @relation("BidCounter")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([listingId, status])
  @@index([bidderUserId])
  @@map("bid")
}

// ── Work-loop: contracts (the living hire container) ─────────────────────────────
/// The hire's living container — created on a Board hire (provider) or a native bid accept. `id` is the
/// stable contract_ref Board grants against. Participant-scoped (client + the vetted contractor).
model Contract {
  id               String         @id @default(uuid()) @db.Uuid
  listingId        String?        @map("listing_id") @db.Uuid // nullable — direct contracts allowed
  listing          Listing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  clientUserId     String         @map("client_user_id") // counterparty (listing owner / Board member)
  contractorUserId String         @map("contractor_user_id") // the vetted contractor
  boardRef         String?        @map("board_ref") // opaque Board id; REFERENCE, never FK
  title            String
  rateType         BudgetType     @map("rate_type")
  rateAmount       Decimal        @map("rate_amount") @db.Decimal(12, 2)
  status            ContractStatus @default(active)
  definitionOfDone  String?        @map("definition_of_done") @db.Text // agreed acceptance bar (contractor drafts; mutual-lock later)
  standupRequestedAt DateTime?     @map("standup_requested_at") // set when the client requests a stand-up; cleared when one is posted
  standupCadence    String?        @map("standup_cadence") // the client's cadence preference (daily/weekdays/weekly/…), advisory
  startedAt         DateTime       @default(now()) @map("started_at")
  endedAt          DateTime?      @map("ended_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  items        ContractItem[]
  timeEntries  TimeEntry[]
  billingCycles BillingCycle[]
  reviews      ContractorReview[]
  standups     Standup[]
  sprints      Sprint[]
  blockers     Blocker[]
  changeRequests ChangeRequest[]
  charter      Charter?
  ledgerEntries LedgerEntry[]
  docs         ContractDoc[]

  @@index([contractorUserId])
  @@index([clientUserId])
  @@index([status])
  @@index([boardRef])
  @@map("contract")
}

/// An agile stand-up on a contract — a structured progress update (done / next / blockers) posted by a
/// participant. The first of the chat-mediated agile ceremonies; participant-scoped to the contract.
model Standup {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  byUserId   String   @map("by_user_id") // who posted it (the contractor in v1)
  done       String   @db.Text
  next       String   @db.Text
  blockers   String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([contractId, createdAt])
  @@map("standup")
}

/// An agile sprint on a contract — a two-party-negotiated collection of tasks + a time-to-deliver. Either party
/// proposes; edits reset the other's approval (the counter-edit game); both-approved → agreed. Effort points
/// (≈ hours) sum to the expected billed time → × the rate = the expected budget. `items` = [{ title, effortPoints }].
model Sprint {
  id                 String       @id @default(uuid()) @db.Uuid
  contractId         String       @map("contract_id") @db.Uuid
  contract           Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  status             SprintStatus @default(proposed)
  ttdDays            Int          @map("ttd_days") // time-to-deliver window, in days
  items              Json         @db.JsonB // [{ title: string, effortPoints: number }]
  clientApproved     Boolean      @default(false) @map("client_approved")
  contractorApproved Boolean      @default(false) @map("contractor_approved")
  lastEditedByRole   String       @map("last_edited_by_role") // 'client' | 'contractor'
  // review / acceptance (agreed → contractor submits → review → client accepts → completed)
  submittedAt        DateTime?    @map("submitted_at")
  reviewDueAt        DateTime?    @map("review_due_at") // auto-accept deadline (display now; the cron lands later)
  acceptedAt         DateTime?    @map("accepted_at")
  autoAccepted       Boolean      @default(false) @map("auto_accepted")
  submissionNote     String?      @map("submission_note") @db.Text // what the contractor delivered / how to verify
  changeRequestNote  String?      @map("change_request_note") @db.Text // the client's requested changes
  createdAt          DateTime     @default(now()) @map("created_at")
  agreedAt           DateTime?    @map("agreed_at")

  @@index([contractId, createdAt])
  @@map("sprint")
}

enum SprintStatus {
  proposed
  agreed
  review
  completed
  cancelled
}

/// An agile blocker on a contract — work is stalled (the contractor is waiting on the client, or either party
/// flags an impediment). While a blocker is OPEN, billable clock is paused; the [createdAt, resolvedAt] interval
/// is the paused window (the billing/timer exclusion ties in later). Either participant can raise or resolve.
model Blocker {
  id             String        @id @default(uuid()) @db.Uuid
  contractId     String        @map("contract_id") @db.Uuid
  contract       Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sprintId       String?       @map("sprint_id") @db.Uuid // optional: scope a blocker to a sprint (reference, not enforced)
  status         BlockerStatus @default(open)
  reason         String        @db.Text // what is blocking the work
  raisedByRole   String        @map("raised_by_role") // 'client' | 'contractor'
  raisedByUserId String        @map("raised_by_user_id")
  resolutionNote String?       @map("resolution_note") @db.Text
  resolvedByRole String?       @map("resolved_by_role")
  createdAt      DateTime      @default(now()) @map("created_at")
  resolvedAt     DateTime?     @map("resolved_at")

  @@index([contractId, status])
  @@map("blocker")
}

enum BlockerStatus {
  open
  resolved
}

/// An agile change-request on a contract — a mid-flight amendment (scope / rate / timeline) that BOTH parties
/// negotiate to agreement. Same counter-edit game as a sprint: an edit by either side resets the other's
/// approval; both-approved → agreed. A `rate` change records the proposed new rate but does NOT touch the
/// contract/billing until ENACTED (the deferred apply step writes `appliedAt`); scope/timeline/other are
/// documentary once agreed. Participant-scoped.
model ChangeRequest {
  id                 String              @id @default(uuid()) @db.Uuid
  contractId         String              @map("contract_id") @db.Uuid
  contract           Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind               ChangeRequestKind
  title              String
  detail             String              @db.Text
  proposedRateType   BudgetType?         @map("proposed_rate_type") // rate kind only
  proposedRateAmount Decimal?            @map("proposed_rate_amount") @db.Decimal(12, 2) // rate kind only
  status             ChangeRequestStatus @default(proposed)
  clientApproved     Boolean             @default(false) @map("client_approved")
  contractorApproved Boolean             @default(false) @map("contractor_approved")
  lastEditedByRole   String              @map("last_edited_by_role") // 'client' | 'contractor'
  appliedAt          DateTime?           @map("applied_at") // set when an agreed change is enacted (deferred)
  createdAt          DateTime            @default(now()) @map("created_at")
  agreedAt           DateTime?           @map("agreed_at")

  @@index([contractId, createdAt])
  @@map("change_request")
}

enum ChangeRequestKind {
  scope
  rate
  timeline
  other
}

enum ChangeRequestStatus {
  proposed
  agreed
  withdrawn
}

/// An agile kickoff charter on a contract — the front-door alignment doc (goals / working agreement / success
/// criteria) plus a close-out reflection at the end. ONE per contract (singleton). Collaborative: either party
/// edits while in draft; an edit resets acknowledgments; both acknowledge → kicked off (kickedOffAt). At close,
/// a shared close-out note + closedAt (the formal review stays in ContractorReview — linked, not duplicated).
model Charter {
  id                     String    @id @default(uuid()) @db.Uuid
  contractId             String    @unique @map("contract_id") @db.Uuid
  contract               Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  goals                  String?   @db.Text
  workingAgreement       String?   @map("working_agreement") @db.Text
  successCriteria        String?   @map("success_criteria") @db.Text
  clientAcknowledged     Boolean   @default(false) @map("client_acknowledged")
  contractorAcknowledged Boolean   @default(false) @map("contractor_acknowledged")
  lastEditedByRole       String?   @map("last_edited_by_role") // 'client' | 'contractor'
  kickedOffAt            DateTime? @map("kicked_off_at")
  closeOutNote           String?   @map("close_out_note") @db.Text
  closedAt               DateTime? @map("closed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("charter")
}

/// A client's review of the contractor on a contract. `weekly` reviews are private until the contractor
/// APPROVES them for display; the `final` end-of-contract review is ALWAYS public (contractor can't suppress).
/// The aggregate rating shown on the public profile is the displayed set (all final + approved weekly).
model ContractorReview {
  id                 String     @id @default(uuid()) @db.Uuid
  contractId         String     @map("contract_id") @db.Uuid
  contract           Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractorUserId   String     @map("contractor_user_id") // denormalized for the public-profile query
  authorRef          String     @map("author_ref") // the client — clientUserId (native) or boardRef (Board); opaque
  authorLabel        String?    @map("author_label") // optional display label (e.g. the Board workspace name)
  kind               ReviewKind
  rating             Int? // overall 1..5 — finals: rounded mean of dimensions; legacy: as-given; weekly pulse: null
  pulse              ReviewPulse? // weekly sentiment (up/neutral/down) — the 2-second touch
  dimensions         Json? @db.JsonB // final only: { communication, quality, timeliness, collaboration } each 1..5
  kudos              String[] @default([]) // endorsement chip keys (collected as badges on the public profile)
  body               String?    @db.Text // optional one-liner (weekly); required comment (final, app-enforced)
  weekOf             DateTime?  @map("week_of") // ISO week start for a weekly review; null for the final
  approvedForDisplay Boolean    @default(false) @map("approved_for_display") // weekly opt-in; ignored for final (always shown)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@unique([contractId, weekOf]) // one weekly per (contract, week); finals (null weekOf) are app-enforced single
  @@index([contractorUserId])
  @@map("contractor_review")
}

enum ReviewKind {
  weekly
  final
}

enum ReviewPulse {
  up
  neutral
  down
}

/// An expandable part of a contract (milestone / scope-add / deliverable / note). Inherits the contract's scope.
model ContractItem {
  id          String             @id @default(uuid()) @db.Uuid
  contractId  String             @map("contract_id") @db.Uuid
  contract    Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind        ContractItemKind
  title       String
  description String?             @db.Text
  amount      Decimal?            @db.Decimal(12, 2)
  status      ContractItemStatus @default(open)
  order       Int                @default(0)
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([contractId])
  @@map("contract_item")
}

/// A unit of tracked work against a contract — from the timer (start/stop), the browser extension, or a
/// manual entry. Owner = the contract's contractor (the only writer). `ended_at` is null while a timer
/// runs. ONLY `approved = true` entries are billable (the client approves; the payments cycle sums those).
/// `billing_cycle_id` is set when a future payments cycle sweeps the entry (no FK yet — payments slice).
model TimeEntry {
  id               String     @id @default(uuid()) @db.Uuid
  contractId       String     @map("contract_id") @db.Uuid
  contract         Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractorUserId String     @map("contractor_user_id") // owner (Clerk User id)
  startedAt        DateTime   @map("started_at")
  endedAt          DateTime?  @map("ended_at") // open while running
  durationSeconds  Int        @default(0) @map("duration_seconds") // computed from started/ended on stop
  description      String?    @db.Text
  source           TimeSource @default(timer)
  approved         Boolean    @default(false) // client approval; only approved time bills
  approvedAt       DateTime?  @map("approved_at")
  disputed         Boolean    @default(false) // client contests the entry; contested time can't bill until resolved
  disputeReason    String?    @map("dispute_reason") @db.Text // why the client disputed it
  disputedAt       DateTime?  @map("disputed_at")
  billingCycleId   String?    @map("billing_cycle_id") @db.Uuid // set when swept into a cycle (payments slice)
  billingCycle     BillingCycle? @relation(fields: [billingCycleId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now()) @map("created_at")

  activities TimeActivity[]

  @@index([contractId])
  @@index([contractorUserId])
  @@index([contractId, approved])
  @@index([disputed])
  @@map("time_entry")
}

// ── Payments (Stripe Connect Express; weekly cycle; platform-initiated charges; Stripe stubbed when unset) ──
enum StripeKycStatus {
  pending
  verified
  restricted
}

enum BillingCycleStatus {
  open
  dispute_window
  charged
  disputed
  voided
}

enum ChargeStatus {
  pending
  succeeded
  failed
  refunded
}

enum PayoutStatus {
  pending
  paid
  failed
}

enum CycleDisputeStatus {
  open
  resolved_charge
  resolved_void
}

/// A contractor's Stripe Connect (Express) account — the payout destination. Status fields mirror Stripe via the webhook.
model StripeAccount {
  id               String          @id @default(uuid()) @db.Uuid
  contractorUserId String          @unique @map("contractor_user_id")
  stripeAccountId  String          @unique @map("stripe_account_id")
  chargesEnabled   Boolean         @default(false) @map("charges_enabled")
  payoutsEnabled   Boolean         @default(false) @map("payouts_enabled")
  kycStatus        StripeKycStatus @default(pending) @map("kyc_status")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("stripe_account")
}

/// One weekly bill per contract: sweeps APPROVED time, opens a dispute window, then charges after it (no escrow).
model BillingCycle {
  id                  String             @id @default(uuid()) @db.Uuid
  contractId          String             @map("contract_id") @db.Uuid
  contract            Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  periodStart         DateTime           @map("period_start")
  periodEnd           DateTime           @map("period_end")
  status              BillingCycleStatus @default(open)
  totalSeconds        Int                @default(0) @map("total_seconds")
  totalAmount         Decimal            @default(0) @map("total_amount") @db.Decimal(12, 2)
  takeRateAmount      Decimal            @default(0) @map("take_rate_amount") @db.Decimal(12, 2)
  disputeWindowEndsAt DateTime           @map("dispute_window_ends_at")
  chargeReminderSentAt DateTime?         @map("charge_reminder_sent_at") // T-24h "charging soon" reminder fired
  chargedAt           DateTime?          @map("charged_at")
  createdAt           DateTime           @default(now()) @map("created_at")

  entries  TimeEntry[]
  charge   Charge?
  disputes CycleDispute[]

  @@unique([contractId, periodStart])
  @@index([status])
  @@map("billing_cycle")
}

/// The platform-initiated charge to the client for one cycle (1:1). Idempotency-keyed; Stripe ids null until issued.
model Charge {
  id                    String       @id @default(uuid()) @db.Uuid
  billingCycleId        String       @unique @map("billing_cycle_id") @db.Uuid
  cycle                 BillingCycle @relation(fields: [billingCycleId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String?      @map("stripe_payment_intent_id")
  clientUserId          String       @map("client_user_id")
  contractorUserId      String       @map("contractor_user_id")
  grossAmount           Decimal      @map("gross_amount") @db.Decimal(12, 2)
  takeRateAmount        Decimal      @map("take_rate_amount") @db.Decimal(12, 2)
  netAmount             Decimal      @map("net_amount") @db.Decimal(12, 2)
  status                ChargeStatus @default(pending)
  idempotencyKey        String       @unique @map("idempotency_key")
  createdAt             DateTime     @default(now()) @map("created_at")
  succeededAt           DateTime?    @map("succeeded_at")

  payout Payout?

  @@map("charge")
}

/// The transfer of the net to the contractor's connected account (after a succeeded charge).
model Payout {
  id               String       @id @default(uuid()) @db.Uuid
  chargeId         String       @unique @map("charge_id") @db.Uuid
  charge           Charge       @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  stripeTransferId String?      @map("stripe_transfer_id")
  contractorUserId String       @map("contractor_user_id")
  amount           Decimal      @db.Decimal(12, 2)
  status           PayoutStatus @default(pending)
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([contractorUserId])
  @@map("payout")
}

/// A cycle-level dispute (distinct from a per-entry time dispute) — an open one blocks the cycle's charge.
model CycleDispute {
  id             String             @id @default(uuid()) @db.Uuid
  billingCycleId String             @map("billing_cycle_id") @db.Uuid
  cycle          BillingCycle       @relation(fields: [billingCycleId], references: [id], onDelete: Cascade)
  raisedByUserId String             @map("raised_by_user_id")
  reason         String             @db.Text
  status         CycleDisputeStatus @default(open)
  resolutionNote String?            @map("resolution_note")
  createdAt      DateTime           @default(now()) @map("created_at")
  resolvedAt     DateTime?          @map("resolved_at")

  @@index([billingCycleId])
  @@map("cycle_dispute")
}

/// A client's (Board member's) saved Stripe customer + default card, so platform-initiated cycle charges have
/// a payment method to charge. Keyed by the opaque client Clerk user id. No raw card data is stored — Stripe
/// holds it; we keep only the customer id, the default payment-method id, and brand/last4 for display.
model ClientBilling {
  id                     String              @id @default(uuid()) @db.Uuid
  clientUserId           String              @unique @map("client_user_id")
  stripeCustomerId       String              @unique @map("stripe_customer_id")
  defaultPaymentMethodId String?             @map("default_payment_method_id")
  cardBrand              String?             @map("card_brand")
  cardLast4              String?             @map("card_last4")
  status                 ClientBillingStatus @default(pending)
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  @@map("client_billing")
}

/// pending = a Stripe customer exists but no card yet; ready = a default payment method is saved.
enum ClientBillingStatus {
  pending
  ready
}

/// A client's (Board member's) GOVERNANCE standing — the kill-switch the owner (or an auto charge-decline) flips.
/// Clients have no contractor_identity, so this is their gate. `suspended` = the client's contracting is shut off:
/// their contractors can't clock time on the client's contracts (enforced at the timer write), running timers are
/// stopped, and both sides are notified. Absent row = active (the default). Standing is the source of truth — we
/// do NOT mutate each contract's status, so reinstating cleanly restores everything.
model ClientStanding {
  clientUserId      String              @id @map("client_user_id")
  status            ClientStandingStatus @default(active)
  reason            String?             // reason code (payment_declined / non_payment / abuse / request / other)
  note              String?             @db.Text
  source            StandingSource?     // how it was suspended
  suspendedByUserId String?             @map("suspended_by_user_id") // the admin, or null for auto
  suspendedAt       DateTime?           @map("suspended_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([status])
  @@map("client_standing")
}

enum ClientStandingStatus {
  active
  suspended
}

enum StandingSource {
  manual
  auto_decline
}

/// The IMMUTABLE, append-only financial ledger — one row per money event (a cycle charge, a failed charge, a
/// refund, a chargeback, a manual adjustment). The audit-grade source of truth behind dashboards / stats /
/// exports / disputes; fully attributed so we can always answer who/where/what/why/when, and carries the Stripe
/// ids so it's reconcilable against Stripe forever. Derived from the charge/payout lifecycle (which holds the
/// operational state); never edited in place — a correction is a NEW row. Readable by both participants.
model LedgerEntry {
  id                    String     @id @default(uuid()) @db.Uuid
  kind                  LedgerKind
  // who
  clientUserId          String     @map("client_user_id")
  contractorUserId      String     @map("contractor_user_id")
  // where
  contractId            String?    @map("contract_id") @db.Uuid
  contract              Contract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  boardRef              String?    @map("board_ref") // → the originating project (opaque cross-app ref)
  billingCycleId        String?    @map("billing_cycle_id") @db.Uuid
  chargeId              String?    @map("charge_id") @db.Uuid
  // what
  grossAmount           Decimal    @map("gross_amount") @db.Decimal(12, 2) // what the client is billed
  feeAmount             Decimal    @default(0) @map("fee_amount") @db.Decimal(12, 2) // platform take
  netAmount             Decimal    @map("net_amount") @db.Decimal(12, 2) // what the contractor earns
  currency              String     @default("usd")
  // why / context
  description           String
  periodStart           DateTime?  @map("period_start") // the work week settled
  periodEnd             DateTime?  @map("period_end")
  taskCount             Int        @default(0) @map("task_count") // # of time entries settled (→ tasks/project)
  totalSeconds          Int        @default(0) @map("total_seconds")
  // stripe (reconcilable)
  stripePaymentIntentId String?    @map("stripe_payment_intent_id")
  stripeTransferId      String?    @map("stripe_transfer_id")
  // outcome
  succeeded             Boolean    @default(true)
  failureReason         String?    @map("failure_reason")
  // when
  occurredAt            DateTime   @map("occurred_at")
  idempotencyKey        String     @unique @map("idempotency_key") // one row per event; safe re-runs
  createdAt             DateTime   @default(now()) @map("created_at")

  @@index([clientUserId, occurredAt])
  @@index([contractorUserId, occurredAt])
  @@index([contractId])
  @@index([billingCycleId])
  @@map("ledger_entry")
}

enum LedgerKind {
  charge // a successful weekly cycle charge (client debited, contractor paid)
  charge_failed // a declined charge attempt
  refund
  chargeback
  adjustment // a manual correction (admin)
}

/// An OPTIONAL agreement document attached to a contract — an NDA, IP assignment, confidentiality, an independent-
/// contractor agreement, a non-solicit, or a custom doc (started from a template or written from scratch). A
/// participant adds it; the adder edits/removes while UNSIGNED; both parties e-sign (a typed name + timestamp =
/// the audit trail). Once anyone has signed it locks; executed = both signed. Participant-scoped.
model ContractDoc {
  id                   String          @id @default(uuid()) @db.Uuid
  contractId           String          @map("contract_id") @db.Uuid
  contract             Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind                 ContractDocKind
  title                String
  body                 String          @db.Text
  addedByRole          String          @map("added_by_role") // 'client' | 'contractor'
  clientSignedAt       DateTime?       @map("client_signed_at")
  clientSignerName     String?         @map("client_signer_name") // the typed name = the e-signature
  contractorSignedAt   DateTime?       @map("contractor_signed_at")
  contractorSignerName String?         @map("contractor_signer_name")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@index([contractId])
  @@map("contract_doc")
}

enum ContractDocKind {
  nda
  ip_assignment
  confidentiality
  ic_agreement
  non_solicit
  custom
}

/// Plugin-timer evidence: an activity sample tied to a time_entry (activity %, what they were on, an optional
/// screenshot stored in R2 by key). The client sees these (time-tracker model); contractors see their own.
model TimeActivity {
  id               String    @id @default(uuid()) @db.Uuid
  timeEntryId      String    @map("time_entry_id") @db.Uuid
  entry            TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  contractorUserId String    @map("contractor_user_id") // owner (audit; matches the entry's contractor)
  capturedAt       DateTime  @map("captured_at")
  activityPct      Int?      @map("activity_pct") // 0–100 keyboard/mouse activity for the interval
  title            String? // the active app/window gist
  screenshotKey    String?   @map("screenshot_key") // R2 object key (served via a short-lived signed URL)
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([timeEntryId, capturedAt])
  @@map("time_activity")
}

/// A per-contractor token the browser-timer extension authenticates with (it can't hold the server service key).
/// Minted in-app (plaintext shown once); only the sha256 hash is stored; revocable.
model ExtensionToken {
  id               String    @id @default(uuid()) @db.Uuid
  contractorUserId String    @map("contractor_user_id")
  tokenHash        String    @unique @map("token_hash") // sha256 of the plaintext token
  label            String?
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([contractorUserId])
  @@map("extension_token")
}

// ── Platform furniture ─────────────────────────────────────────────────────────
/// Immutable platform event log (user-scoped platform; no tenant). System-written via ctx.events.
model AppEvent {
  id         String    @id @default(uuid()) @db.Uuid
  source     String
  type       String
  actorId    String    @map("actor_id")
  actorType  ActorType @map("actor_type")
  payload    Json      @default("{}")
  occurredAt DateTime  @default(now()) @map("occurred_at")

  @@index([type])
  @@index([source])
  @@index([occurredAt])
  @@map("app_event")
}

/// BASELINE-SAAS feature flags. Global (user_id null) or per-user override.
model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  userId    String?  @map("user_id") // null = global; set = per-user override
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([key, userId])
  @@index([key])
  @@map("feature_flag")
}
